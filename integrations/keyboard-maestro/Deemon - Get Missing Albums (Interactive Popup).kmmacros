						<key>Text</key>
						<string>&lt;!doctype html&gt;
&lt;html&gt;&lt;head&gt;&lt;meta charset="utf-8"&gt;&lt;title&gt;Deemon Toolkit&lt;/title&gt;&lt;style&gt;
:root{color-scheme:dark;--bg:#101010;--card:#181818;--panel:#202020;--panel2:#292929;--text:#f2eadf;--muted:#aaa;--border:#3a3a3a;--accent:#04d58f;--danger:#a84a4a}
*{box-sizing:border-box}
html,body{height:100%;width:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--text);font:14px/1.35 -apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,sans-serif}
body{padding:10px}
form.app{height:100%;display:grid;grid-template-rows:auto 1fr auto;gap:8px;min-width:0;min-height:0}
.header{display:flex;align-items:center;gap:12px;min-height:36px}
.header h1{font-size:21px;line-height:1;margin:0;font-weight:800;white-space:nowrap}
.sub{color:var(--muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spacer{flex:1}
.main{min-height:0;min-width:0;display:grid;gap:8px;grid-template-columns:1fr}
.card{min-width:0;min-height:0;border:1px solid var(--border);border-radius:12px;background:var(--card);padding:8px;display:flex;flex-direction:column;gap:8px;overflow:hidden}
.toolbar{display:flex;flex-wrap:wrap;align-items:flex-start;gap:5px;align-content:flex-start}
.toolbar button,.footer button,.header button{appearance:none;border:1px solid var(--border);border-radius:8px;background:var(--panel2);color:var(--text);font:600 12px/1 -apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,sans-serif;padding:6px 8px;min-height:26px;max-height:30px;cursor:pointer;white-space:nowrap}
.toolbar button:hover,.footer button:hover,.header button:hover{border-color:var(--accent)}
textarea{flex:1;min-height:0;min-width:0;background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:8px;padding:12px;font:13px/1.4 Menlo,Monaco,Consolas,monospace;resize:none;outline:none;white-space:pre-wrap;box-shadow:inset 0 1px 3px rgba(0,0,0,.2)}
textarea:focus{border-color:var(--accent)}
&lt;/style&gt;
&lt;/head&gt;&lt;body data-kmwindow="SCREEN(Main,MidX)-400,SCREEN(Main,MidY)-300,800,600"&gt;
&lt;form class="app" method="post"&gt;
&lt;div class="header" id="grip"&gt;
  &lt;h1&gt;Deemon Toolkit&lt;/h1&gt;
  &lt;div class="sub" id="status"&gt;Ready&lt;/div&gt;
  &lt;div class="spacer"&gt;&lt;/div&gt;
  &lt;button type="button" onclick="window.KeyboardMaestro.Cancel()"&gt;Cancel&lt;/button&gt;
&lt;/div&gt;
&lt;div class="main"&gt;
  &lt;div class="card"&gt;
    &lt;div class="toolbar"&gt;
      &lt;button type="button" onclick="window.KeyboardMaestro.Submit('Send to Deemon')"&gt;Send to Deemon&lt;/button&gt;
      &lt;button type="button" onclick="window.KeyboardMaestro.Submit('Append to List')"&gt;Append to List&lt;/button&gt;
      &lt;button type="button" onclick="window.KeyboardMaestro.Submit('Save New File')"&gt;Save New File&lt;/button&gt;
    &lt;/div&gt;
    &lt;textarea id="result" name="MAMissing_Result" wrap="soft"&gt;&lt;/textarea&gt;
  &lt;/div&gt;
&lt;/div&gt;
&lt;/form&gt;
&lt;script&gt;
document.addEventListener('DOMContentLoaded',()=&gt;{
  try {
    document.getElementById('result').value = window.KeyboardMaestro.GetVariable("MAMissing_Result");
    const summary = window.KeyboardMaestro.GetVariable("MAMissing_Summary");
    if(summary) document.getElementById('status').textContent = summary;
  } catch(e) {}
});
&lt;/script&gt;
&lt;/body&gt;&lt;/html&gt;</string>
